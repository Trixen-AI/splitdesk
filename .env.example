# Splitdesk environment. Copy to .env for local dev; add the same keys in
# Vercel > Project > Settings > Environment Variables (Production + Preview).
# VITE_* values are bundled into the browser build: never put secrets in them.
# After changing any VITE_* value, restart `npm run dev` or redeploy on Vercel.

# --- Required ---
# Reown Cloud project ID (https://cloud.reown.com) for the wallet modal in /app.
# In Reown Cloud also add https://splitdesk.fun (and your *.vercel.app preview URL) to the allowed domains.
VITE_REOWN_PROJECT_ID=

# --- Recommended ---
# mainnet-beta (default) or devnet for testing
VITE_SOLANA_CLUSTER=mainnet-beta
# Dedicated Solana RPC (Helius, Triton, QuickNode...). Empty = Reown RPC via the project ID above.
# A dedicated RPC makes My coins / Payouts lookups (getProgramAccounts) faster and more reliable.
VITE_SOLANA_RPC=

# --- Optional ---
# Public key of the desk payout authority. Each X account vault is
# createWithSeed(authority, "x:<handle>", SystemProgram). Empty = the creator's own wallet.
VITE_DESK_BASE_ADDRESS=

# Server only (never exposed to the browser).
# Receives every finished launch and payout request (the desk payout queue).
# Without it on Vercel, launches are only written to the function logs and payout requests return 501.
DESK_WEBHOOK_URL=
